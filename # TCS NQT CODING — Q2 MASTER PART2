───────────────────────────────────────────────────────────────

## CODE — DFS

```
void dfs(
    vector<vector<int>>& grid,
    int r,
    int c
) {

    int n = grid.size();
    int m = grid[0].size();

    if(r < 0 || r >= n ||
       c < 0 || c >= m ||
       grid[r][c] == 0)
        return;

    grid[r][c] = 0;

    dfs(grid, r+1, c);
    dfs(grid, r-1, c);
    dfs(grid, r, c+1);
    dfs(grid, r, c-1);
}

int countIslands(
    vector<vector<int>>& grid
) {

    int count = 0;

    for(int r = 0; r < n; r++) {

        for(int c = 0; c < m; c++) {

            if(grid[r][c] == 1) {

                count++;

                dfs(grid, r, c);
            }
        }
    }

    return count;
}
```

───────────────────────────────────────────────────────────────

## MASTER IDEA

```
FIND UNVISITED COMPONENT
        ↓
    COUNT +1
        ↓
    FLOOD FILL
        ↓
MARK WHOLE COMPONENT
```

───────────────────────────────────────────────────────────────

