        char top = st.top();

        if((c == ')' && top != '(') ||
           (c == '}' && top != '{') ||
           (c == ']' && top != '[')) {

            cout << "NO";
            return;
        }

        st.pop();
    }
}

cout << (st.empty() ? "YES" : "NO");
```

